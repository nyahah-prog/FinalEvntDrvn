{{> head}}
{{> navbar}}
<main class="container auth-wrap"><section class="auth-card">
  <span class="eyebrow">Welcome back</span><h1>Sign in</h1><p>Access your SupplyHub workspace.</p>
  {{> messages}}
  <form action="/login" method="post" class="form-stack">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <label>Email<input type="email" name="email" value="{{email}}" maxlength="191" autocomplete="username" required></label>
    <label>Password<input type="password" name="password" autocomplete="current-password" required></label>
    <button class="button" type="submit">Sign in</button>
  </form>
  <p><a href="/forgot-password">Account assistance</a></p>
  <p class="muted">New here? <a href="/register">Create an account</a></p>
</section></main>
{{> footer}}
