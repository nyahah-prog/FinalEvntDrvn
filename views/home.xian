{{> head}}
{{> navbar}}
<main class="container">
  <section class="hero"><span class="eyebrow">One store. Four connected teams.</span>
    <h1>{{appTitle}}</h1>
    <p>An editable starting point for Finance, POS, Inventory, and Human Resource.</p>
    <a class="button" href="/login">Open your workspace</a>
  </section>
  <section class="module-grid" aria-label="System modules">
    {{#each modules}}
    <article class="module-card"><span class="badge">Module</span>
      <h2>{{name}}</h2><p>{{description}}</p>
      <a class="text-link" href="{{path}}">Open module &rarr;</a></article>
    {{/each}}
  </section>
</main>
{{> footer}}
